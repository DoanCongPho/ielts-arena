00000000004,"end":28.25000000000004},{"word":"anyone","start":28.30000000000004,"end":28.60000000000004}]},{"question_id":"p2.f1","part":2,"question":"Do you often read?","audio_key":"speaking/1/p2.f1.webm","text":"Not very often these days, maybe one book a month.","duration":4,"words":[{"word":"Not","start":0,"end":0.3},{"word":"very","start":0.35,"end":0.6499999999999999},{"word":"often","start":0.7,"end":1},{"word":"these","start":1.0499999999999998,"end":1.3499999999999999},{"word":"days","start":1.4,"end":1.7},{"word":"maybe","start":1.75,"end":2.05},{"word":"one","start":2.1,"end":2.4},{"word":"book","start":2.45,"end":2.75},{"word":"a","start":2.8000000000000003,"end":3.1},{"word":"month","start":3.1500000000000004,"end":3.45}]},{"question_id":"p3.q1","part":3,"question":"Why do people read less today?","audio_key":"speaking/1/p3.q1.webm","text":"I think people read less because smartphones compete for our attention and short videos is more fun.","duration":7.649999999999999,"words":[{"word":"I","start":0,"end":0.3},{"word":"think","start":0.35,"end":0.6499999999999999},{"word":"people","start":0.7,"end":1},{"word":"read","start":1.0499999999999998,"end":1.3499999999999999},{"word":"less","start":1.4,"end":1.7},{"word":"because","start":1.75,"end":2.05},{"word":"smartphones","start":2.1,"end":2.4},{"word":"compete","start":2.45,"end":2.75},{"word":"for","start":2.8000000000000003,"end":3.1},{"word":"our","start":3.1500000000000004,"end":3.45},{"word":"attention","start":3.5000000000000004,"end":3.8000000000000003},{"word":"and","start":5.050000000000001,"end":5.3500000000000005},{"word":"short","start":5.4,"end":5.7},{"word":"videos","start":5.75,"end":6.05},{"word":"is","start":6.1,"end":6.3999999999999995},{"word":"more","start":6.449999999999999,"end":6.749999999999999},{"word":"fun","start":6.799999999999999,"end":7.099999999999999}]},{"question_id":"p3.q2","part":3,"question":"Should schools make reading compulsory?","audio_key":"speaking/1/p3.q2.webm",