# Database
DB_HOST = localhost
DB_PORT = 3306
DB_USER =
DB_PASSWORD =
DB_NAME =
# Verified TLS to the DB. Leave false for local compose MySQL; set true for
# managed MySQL such as TiDB Cloud (port 4000), which requires it.
DB_TLS = false

# App
PORT = 8080
APP_ENV = development
# Applies pending migrations at boot. Previously this was parsed and then
# never used, so a fresh database booted with no tables.
AUTO_MIGRATE = true

# Required — the server refuses to start without it. Generate one with:
#   openssl rand -base64 48
SECRET_KEY =

# LLM grading (writing/speaking)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Speaking. OpenAI transcribes answers (Whisper, for word timings), judges
# the four criteria against the band descriptors, and voices the examiner.
# SPEAKING_MODEL does the judging — a judgement task, so use a stronger model
# than OPENAI_MODEL's default if you can; empty means OPENAI_MODEL.
WHISPER_MODEL=whisper-1
SPEAKING_MODEL=
EXAMINER_TTS_MODEL=gpt-4o-mini-tts
EXAMINER_VOICE=sage
# The self-hosted pronunciation service (services/pronunciation, deployed on
# an Oracle Cloud Always Free VM — see its README). Empty: pronunciation is
# estimated from speech recognition confidence and capped at band 7.
PRON_SERVICE_URL=
PRON_SERVICE_TOKEN=
PRON_SERVICE_TIMEOUT_SECONDS=180
# A speaking grade transcribes every answer and waits on the pronunciation
# service, so it gets far longer than GRADING_JOB_TIMEOUT_SECONDS.
SPEAKING_JOB_TIMEOUT_SECONDS=720
# Where recordings and examiner audio are kept when S3_BUCKET is empty.
MEDIA_DIR=data/media

# Background grading workers.
# Grading no longer runs inside the HTTP request: submissions are queued and
# a worker pool drains them. GRADING_WORKERS is therefore also the ceiling on
# concurrent OpenAI calls — raising it raises both throughput and spend.
GRADING_WORKERS=2
GRADING_POLL_SECONDS=3
GRADING_JOB_TIMEOUT_SECONDS=90

# CORS. Leave empty for the default deployment: nginx serves the SPA and
# proxies /api to this service, so every request is same-origin and CORS is
# never involved. Set this ONLY when the browser loads the frontend from a
# different origin than this API (e.g. the SPA on Vercel, this on Railway):
#   ALLOWED_ORIGINS=https://ielts-arena.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=

# Production only: serve /assets/* (listening audio, diagrams) from a private
# S3-compatible bucket that mirrors internal/assets (audio/, diagrams/) via
# 1-hour presigned redirects. Leave S3_BUCKET empty locally to serve
# internal/assets from disk. scripts/upload_assets.sh reads the same vars.
# The same bucket stores speaking recordings (speaking/) and examiner audio
# (examiner/). Browsers upload recordings straight to it, so the bucket
# needs a CORS rule allowing PUT and GET from the frontend's origin.
# Backblaze B2 example:
#   S3_PROVIDER=Other
#   S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
#   S3_REGION=us-west-004
S3_PROVIDER=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
