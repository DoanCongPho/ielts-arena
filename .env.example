# Database
DB_HOST = localhost
DB_PORT = 3306
DB_USER =
DB_PASSWORD =
DB_NAME =
# Verified TLS to the DB. Leave false for local compose MySQL; set true for
# managed MySQL such as TiDB Cloud (port 4000), which requires it.
DB_TLS = false

# App
PORT = 8080
APP_ENV = development
# Applies pending migrations at boot. Previously this was parsed and then
# never used, so a fresh database booted with no tables.
AUTO_MIGRATE = true

# Required — the server refuses to start without it. Generate one with:
#   openssl rand -base64 48
SECRET_KEY =

# LLM grading (writing/speaking)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Background grading workers.
# Grading no longer runs inside the HTTP request: submissions are queued and
# a worker pool drains them. GRADING_WORKERS is therefore also the ceiling on
# concurrent OpenAI calls — raising it raises both throughput and spend.
GRADING_WORKERS=2
GRADING_POLL_SECONDS=3
GRADING_JOB_TIMEOUT_SECONDS=90

# CORS. Leave empty for the default deployment: nginx serves the SPA and
# proxies /api to this service, so every request is same-origin and CORS is
# never involved. Set this ONLY when the browser loads the frontend from a
# different origin than this API (e.g. the SPA on Vercel, this on Railway):
#   ALLOWED_ORIGINS=https://ielts-arena.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=

# Production only: serve /assets/* (listening audio, diagrams) from a private
# S3-compatible bucket that mirrors internal/assets (audio/, diagrams/) via
# 1-hour presigned redirects. Leave S3_BUCKET empty locally to serve
# internal/assets from disk. scripts/upload_assets.sh reads the same vars.
# Backblaze B2 example:
#   S3_PROVIDER=Other
#   S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
#   S3_REGION=us-west-004
S3_PROVIDER=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
