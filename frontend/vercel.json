{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ielts-arena-api.onrender.com/api/:path*" },
    { "source": "/assets/:path*", "destination": "https://ielts-arena-api.onrender.com/assets/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
